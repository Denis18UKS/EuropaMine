@@ -0,0 +1,30 @@
+package com.z_mods.barotrauma.logic;
+
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+
+/** Loader-neutral selector rules for destructive submarine commands. */
+public final class SubmarineCommandLogic {
+    private SubmarineCommandLogic() {}
+
+    public record VesselRef(UUID id, String name) {}
+
+    public static Optional<UUID> resolve(String selector, List<VesselRef> vessels) {
+        if (selector == null || selector.isBlank() || vessels == null || vessels.isEmpty()) return Optional.empty();
+        String value = selector.trim();
+        try {
+            UUID id = UUID.fromString(value);
+            return vessels.stream().anyMatch(v -> v.id().equals(id)) ? Optional.of(id) : Optional.empty();
+        } catch (IllegalArgumentException ignored) {
+        }
+        UUID match = null;
+        for (VesselRef vessel : vessels) {
+            if (vessel.name() == null || !vessel.name().equalsIgnoreCase(value)) continue;
+            if (match != null && !match.equals(vessel.id())) return Optional.empty();
+            match = vessel.id();
+        }
+        return Optional.ofNullable(match);
+    }
+}
