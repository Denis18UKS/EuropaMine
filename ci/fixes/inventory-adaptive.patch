+    /** Places a companion panel beside an inventory when possible and never outside the screen. */
+    public static int adaptiveSidePanelX(int screenWidth, int inventoryLeft, int inventoryWidth,
+                                         int panelWidth, int margin) {
+        int safeMargin = Math.max(0, margin);
+        int maxX = Math.max(safeMargin, screenWidth - Math.max(0, panelWidth) - safeMargin);
+        int right = inventoryLeft + Math.max(0, inventoryWidth);
+        if (right + panelWidth <= screenWidth - safeMargin) return clamp(right, safeMargin, maxX);
+        int left = inventoryLeft - panelWidth;
+        if (left >= safeMargin) return clamp(left, safeMargin, maxX);
+        return maxX;
+    }
+
     private static int clamp(int value, int min, int max) {
         return Math.max(min, Math.min(max, value));
     }
